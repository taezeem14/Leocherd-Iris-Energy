# Leocherd Iris Energy Environment Configuration

# Hardware Profile Override (AUTO, CPU_LIGHTWEIGHT, CPU_STANDARD, CUDA_GPU)
IRIS_HARDWARE_PROFILE=AUTO

# Directories (Defaults to project subdirectories on Drive D:)
IRIS_CACHE_DIR=D:/download-chrome/Leocherd-Project/.cache
IRIS_MODELS_DIR=D:/download-chrome/Leocherd-Project/data/models
IRIS_OUTPUTS_DIR=D:/download-chrome/Leocherd-Project/outputs
IRIS_UPLOADS_DIR=D:/download-chrome/Leocherd-Project/data/uploads

# External Tool Executable Paths (Optional overrides)
# BLENDER_EXECUTABLE=C:/Program Files/Blender Foundation/Blender 4.2/blender.exe
FFMPEG_EXECUTABLE=C:/Program Files/Softdeluxe/Free Download Manager/ffmpeg.exe

# Video Ingestion Settings
IRIS_MAX_VIDEO_DURATION_SEC=120
IRIS_DEFAULT_SAMPLE_FPS=15
IRIS_MAX_FRAME_DIMENSION=1280

# API Settings
IRIS_API_HOST=127.0.0.1
IRIS_API_PORT=8000
IRIS_API_DEBUG=false
